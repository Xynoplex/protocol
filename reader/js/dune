; The reader's Validate as JavaScript, for the conformance harness, which
; holds what a service answers to the schemas of a bundle the reader writes.
; validate.d.cts is what it exports, as TypeScript reads it. It carries no
; source map, which Vite, through which vitest loads it, cannot combine.
(env
 (_
  (js_of_ocaml
   (sourcemap no))))

(executable
 (name validate)
 (modules validate)
 (modes js)
 (flags (:standard -open Xynolog_protocol_schema))
 (libraries xynolog_protocol_schema js_of_ocaml))

; The conformance harness's types and tables: every table's types and value,
; and every service schema's types, derived from specs/src whenever it
; changes.
(rule
 (targets protocol.ts)
 (deps
  (source_tree %{project_root}/specs/src))
 (action
  (with-stdout-to
   protocol.ts
   (run %{exe:../derive/derive.exe} typescript %{project_root}/specs/src))))

; What each of the bus's channels carries, read through the model, for the
; conformance harness's types.
(executable
 (name bus)
 (modules bus)
 (flags
  (:standard -open Xynolog_protocol_schema -open Xynolog_protocol))
 (libraries xynolog_protocol yojson))

(rule
 (targets bus.ts)
 (deps
  (source_tree %{project_root}/specs/src))
 (action
  (with-stdout-to
   bus.ts
   (run %{exe:bus.exe} %{project_root}/specs/src))))
