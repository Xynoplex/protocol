{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/SessionGatewayUrlCases.json",
  "description": "session/gateway-url-cases.json: an HTTP endpoint, and the origin a client reaches its gateway at.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "endpoint": {
            "$ref": "https://xynolog.org/protocol/HttpEndpoint.json"
          },
          "origin": {
            "type": [
              "string",
              "null"
            ],
            "description": "The gateway's origin, or null when the host is refused."
          }
        },
        "required": [
          "why",
          "endpoint",
          "origin"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
