{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/SessionRegistryCases.json",
  "description": "session/registry-cases.json: whether two endpoints are one place, and the order a registry shows a knowledge base's open resources in.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "one": {
            "$ref": "https://xynolog.org/protocol/KbEndpoint.json"
          },
          "other": {
            "$ref": "https://xynolog.org/protocol/KbEndpoint.json"
          },
          "samePlace": {
            "type": "boolean",
            "description": "Whether the two are one place."
          }
        },
        "required": [
          "why",
          "one",
          "other",
          "samePlace"
        ],
        "additionalProperties": false
      }
    },
    "openResourceOrder": {
      "type": "array",
      "minItems": 1,
      "description": "How a registry orders a knowledge base's open resources.",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "open": {
            "type": "array",
            "description": "The resources open in the knowledge base, each as stored.json's `openResource` keeps it.",
            "items": {
              "$ref": "https://xynolog.org/protocol/OpenResource.json"
            }
          },
          "shown": {
            "type": "array",
            "description": "The resources' ids, in the order the registry shows them.",
            "items": {
              "$ref": "https://xynolog.org/protocol/ResourceId.json"
            }
          }
        },
        "required": [
          "why",
          "open",
          "shown"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases",
    "openResourceOrder"
  ],
  "additionalProperties": false
}
