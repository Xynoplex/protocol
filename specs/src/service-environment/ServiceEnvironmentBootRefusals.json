{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ServiceEnvironmentBootRefusals.json",
  "description": "service-environment/boot-refusals.json: what a service writes when it refuses to start on its configuration document or its environment.",
  "type": "object",
  "properties": {
    "$comment": {
      "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/$comment"
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "The services that refuse to start so.",
      "items": {
        "$ref": "https://xynolog.org/protocol/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/services/items"
      }
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "description": "The one line the service writes to stderr, its refusal in place of `{refusal}`, before it exits."
    },
    "exitCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255,
      "description": "The status it exits with."
    },
    "refusals": {
      "type": "array",
      "minItems": 1,
      "description": "Each refusal.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The situation's name.",
            "pattern": "^[a-z][a-z-]*[a-z]$"
          },
          "situation": {
            "type": "string",
            "minLength": 1,
            "description": "When it is written, and what fills each `{name}` of its text."
          },
          "refusal": {
            "type": "string",
            "minLength": 1,
            "description": "Its text. A `{name}` in it is filled with what the row's `situation` names, and nothing else in it varies."
          }
        },
        "required": [
          "name",
          "situation",
          "refusal"
        ],
        "additionalProperties": false
      }
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "description": "Each line of the refusal `invalid`: one for each way the document is not its schema's.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The situation's name.",
            "pattern": "^[a-z][a-z-]*[a-z]$"
          },
          "situation": {
            "type": "string",
            "minLength": 1,
            "description": "When it is written, and what fills each `{name}` of its text."
          },
          "line": {
            "type": "string",
            "minLength": 1,
            "description": "The line, filled as the row's `situation` says."
          }
        },
        "required": [
          "name",
          "situation",
          "line"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$comment",
    "services",
    "line",
    "exitCode",
    "refusals",
    "members"
  ],
  "additionalProperties": false
}
