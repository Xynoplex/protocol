{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/KbIdentityCases.json",
  "description": "kb-identity/cases.json: the identity a reader computes from a knowledge base's project file.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "dir": {
            "type": "string",
            "minLength": 1,
            "description": "The knowledge base's directory, whose name stands for a name no file gives."
          },
          "config": {
            "type": [
              "string",
              "null"
            ],
            "description": "The text of <dir>/.xynolog/config.yaml, or null when there is none."
          },
          "refused": {
            "type": "boolean",
            "description": "Whether the file does not hold to ProjectConfig.json, and every reader refuses it."
          },
          "name": {
            "description": "The name read, or null when the file is refused.",
            "anyOf": [
              {
                "$ref": "https://xynolog.org/protocol/ProjectConfig.json#/properties/project/properties/name"
              },
              {
                "type": "null"
              }
            ]
          },
          "domain": {
            "description": "The domain read, or null when no identity is declared.",
            "anyOf": [
              {
                "$ref": "https://xynolog.org/protocol/ProjectConfig.json#/properties/site/properties/domain"
              },
              {
                "type": "null"
              }
            ]
          },
          "did": {
            "description": "The DID the domain names, or null when no identity is declared.",
            "anyOf": [
              {
                "$ref": "https://xynolog.org/protocol/KbDid.json"
              },
              {
                "type": "null"
              }
            ]
          },
          "resource": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^https://\\S+$",
            "description": "The resource derived from the domain, the audience the gateway's tokens must carry, or null when no identity is declared."
          }
        },
        "required": [
          "why",
          "dir",
          "config",
          "refused",
          "name",
          "domain",
          "did",
          "resource"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
