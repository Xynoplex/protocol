{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobsRetryCases.json",
  "description": "jobs/retry-cases.json: whether a failed attempt is retried.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "retryCount": {
            "type": "integer",
            "minimum": 0,
            "description": "The record's retry count before the failure is applied."
          },
          "maxRetries": {
            "type": "integer",
            "minimum": 0
          },
          "failureClass": {
            "$ref": "https://xynolog.org/protocol/FailureClass.json"
          },
          "retries": {
            "type": "boolean"
          }
        },
        "required": [
          "why",
          "retryCount",
          "maxRetries",
          "retries"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
