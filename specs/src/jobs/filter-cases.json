{
  "$comment": "Whether a job matches a filter, as every implementation must answer it: the Dispatcher choosing the next job a claim takes, and a party checking an announcement against its own claim before it asks. A filter is a partial job description (JobFilter). A job matches when every field the filter states equals the job's at the same path; what the filter leaves out is not compared. `job` is the description as it is announced or held: its `jobType` and its `params`. Each implementation runs every case and fails on a difference. Add a case here before changing any of them.",
  "runBy": {
    "ocaml": ["sdk/ocaml/sdk/test/worker_filters.ml"],
    "csharp": ["sdk/csharp/sdk/tests/Xynolog.Tests/WorkerTests.cs"],
    "swift": ["sdk/swift/sdk/Tests/XynologTests/WorkerTablesTests.swift"],
    "typescript": ["sdk/typescript/core/src/__tests__/job-filter.test.ts"],
    "rust": ["sdk/rust/sdk/tests/job_filter.rs"],
    "python": ["sdk/python/sdk/tests/test_claims.py"],
    "go": ["sdk/go/claims_test.go"],
    "kotlin": ["sdk/kotlin/sdk/src/test/kotlin/xynolog/jobs/JobTablesTest.kt"],
    "haskell": ["sdk/haskell/sdk/test/WorkerCases.hs"]
  },
  "cases": [
    {
      "why": "a mark filter takes a mark job of its motivation",
      "filter": {
        "jobType": "mark",
        "params": {
          "motivation": "tagging"
        }
      },
      "job": {
        "jobType": "mark",
        "params": {
          "motivation": "tagging",
          "schemaId": "irac",
          "categories": [
            "Issue"
          ]
        }
      },
      "matches": true
    },
    {
      "why": "a mark filter takes no mark job of another motivation",
      "filter": {
        "jobType": "mark",
        "params": {
          "motivation": "tagging"
        }
      },
      "job": {
        "jobType": "mark",
        "params": {
          "motivation": "highlighting"
        }
      },
      "matches": false
    },
    {
      "why": "a mark filter takes no yield job",
      "filter": {
        "jobType": "mark",
        "params": {
          "motivation": "tagging"
        }
      },
      "job": {
        "jobType": "yield",
        "params": {
          "title": "Ouranos",
          "storageUri": "file://generated/ouranos.md"
        }
      },
      "matches": false
    },
    {
      "why": "a yield filter takes every yield job, whatever it is asked to make",
      "filter": {
        "jobType": "yield"
      },
      "job": {
        "jobType": "yield",
        "params": {
          "title": "Ouranos",
          "storageUri": "file://generated/ouranos.md",
          "outputMediaType": "application/pdf"
        }
      },
      "matches": true
    },
    {
      "why": "a yield filter takes no mark job",
      "filter": {
        "jobType": "yield"
      },
      "job": {
        "jobType": "mark",
        "params": {
          "motivation": "commenting"
        }
      },
      "matches": false
    },
    {
      "why": "a filter's parameter the job does not state is no match",
      "filter": {
        "jobType": "mark",
        "params": {
          "motivation": "tagging"
        }
      },
      "job": {
        "jobType": "mark",
        "params": {}
      },
      "matches": false
    },
    {
      "why": "a parameter the filter does not state is not compared",
      "filter": {
        "jobType": "mark",
        "params": {
          "motivation": "commenting"
        }
      },
      "job": {
        "jobType": "mark",
        "params": {
          "motivation": "commenting",
          "tone": "scholarly",
          "language": "de"
        }
      },
      "matches": true
    },
    {
      "why": "what the Dispatcher adds to a job it holds is not compared",
      "filter": {
        "jobType": "mark",
        "params": {
          "motivation": "linking"
        }
      },
      "job": {
        "jobType": "mark",
        "params": {
          "motivation": "linking",
          "entityTypes": [
            "Person"
          ],
          "resourceId": "res-1"
        }
      },
      "matches": true
    }
  ]
}
