{
  "description": "retry/cases.json: whether a failed request is worth another attempt, by each of the four rules, and the wait a `Retry-After` header states.",
  "allOf": [
    {
      "$ref": "../CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "rules": {
      "type": "array",
      "minItems": 1,
      "description": "What each rule answers, told apart by `rule`.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "description": "A boot pass or a bus request, asked about a response's status.",
            "properties": {
              "why": {
                "$ref": "../CaseTable.json#/properties/cases/items/properties/why"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "boot"
                ]
              },
              "status": {
                "$ref": "../HttpStatus.json"
              },
              "retries": {
                "type": "boolean"
              }
            },
            "required": [
              "why",
              "rule",
              "status",
              "retries"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "A job's retry budget, asked about a response's status.",
            "properties": {
              "why": {
                "$ref": "../CaseTable.json#/properties/cases/items/properties/why"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "job"
                ]
              },
              "status": {
                "$ref": "../HttpStatus.json"
              },
              "retries": {
                "type": "boolean"
              }
            },
            "required": [
              "why",
              "rule",
              "status",
              "retries"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "An HTTP client's request, asked about a response's status, the request's method, and whether it carries an `Idempotency-Key`. A status or method left out is unstated.",
            "properties": {
              "why": {
                "$ref": "../CaseTable.json#/properties/cases/items/properties/why"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "transport"
                ]
              },
              "status": {
                "$ref": "../HttpStatus.json"
              },
              "method": {
                "type": "string",
                "minLength": 1,
                "description": "The request's method, read in any case."
              },
              "keyed": {
                "type": "boolean",
                "description": "Whether the request carries an `Idempotency-Key`. Left out, it carries none."
              },
              "retries": {
                "type": "boolean"
              }
            },
            "required": [
              "why",
              "rule",
              "retries"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "Exchanging a refresh token at its issuer, asked about the issuer's answer. A status left out is no response at all.",
            "properties": {
              "why": {
                "$ref": "../CaseTable.json#/properties/cases/items/properties/why"
              },
              "rule": {
                "type": "string",
                "enum": [
                  "refresh"
                ]
              },
              "status": {
                "$ref": "../HttpStatus.json"
              },
              "retries": {
                "type": "boolean"
              }
            },
            "required": [
              "why",
              "rule",
              "retries"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "retryAfter": {
      "type": "array",
      "minItems": 1,
      "description": "The wait a `Retry-After` header states.",
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "../CaseTable.json#/properties/cases/items/properties/why"
          },
          "header": {
            "type": ["string", "null"],
            "description": "The header's value as received, or null when the response has none."
          },
          "ms": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "The wait it states, in milliseconds, or null when it states none."
          }
        },
        "required": [
          "why",
          "header",
          "ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "rules",
    "retryAfter"
  ],
  "additionalProperties": false
}
