{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ServiceTelemetryTelemetry.json",
  "description": "service-telemetry/telemetry.json: the telemetry each Xynolog service exports over OTLP: its spans and metrics, the services that export each, and the attributes each carries.",
  "type": "object",
  "properties": {
    "$comment": {
      "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/$comment"
    },
    "sdk": {
      "type": "object",
      "description": "The services that reach the bus through an SDK, and for each the SDK transports it uses, or of a transport it uses part of, the rows it exports.",
      "propertyNames": {
        "$ref": "#/properties/spans/items/properties/services/items"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "description": "Transports of sdk-telemetry, by name, or rows of them, by name.",
        "items": {
          "type": "string",
          "pattern": "^[a-z]+(\\.[a-z_]+)?$"
        }
      }
    },
    "resource": {
      "type": "array",
      "minItems": 1,
      "items": {
        "description": "An attribute of the resource the services' spans and metrics are exported under.",
        "type": "object",
        "properties": {
          "key": {
            "$ref": "#/properties/spans/items/properties/attributes/items/properties/key"
          },
          "services": {
            "$ref": "#/properties/spans/items/properties/services"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "description": "What the attribute says."
          },
          "default": {
            "type": "string",
            "pattern": "\\{service\\}",
            "description": "Its value when nothing says another, with `{service}` the service's name."
          }
        },
        "required": [
          "key",
          "services",
          "meaning"
        ],
        "additionalProperties": false
      }
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The row's name; `{channel}` in it is the bus channel, and `{jobType}` the job's type."
          },
          "services": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "The services that export the row.",
            "items": {
              "type": "string",
              "enum": [
                "archivist",
                "dispatcher",
                "gateway",
                "librarian",
                "smelter",
                "weaver",
                "worker"
              ],
              "description": "A Xynolog service, by its name."
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "client",
              "consumer",
              "internal",
              "producer",
              "server"
            ],
            "description": "The span's kind, in OTLP's words."
          },
          "when": {
            "type": "string",
            "enum": [
              "export",
              "traffic",
              "supervised",
              "fatal"
            ],
            "description": "When the row arrives."
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "description": "What the row says."
          },
          "attributes": {
            "type": "array",
            "description": "The attributes the span carries.",
            "items": {
              "description": "An attribute a row carries.",
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z_]*(\\.[a-z][a-z_]*)*$",
                  "description": "The attribute's key."
                },
                "only": {
                  "type": "string",
                  "minLength": 1,
                  "description": "When alone the attribute is carried: a row's attribute without it is carried every time."
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "The only values it carries, each of the type it is carried as: a string or a boolean.",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "services",
          "kind",
          "when",
          "meaning",
          "attributes"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/properties/spans/items/properties/name"
          },
          "services": {
            "$ref": "#/properties/spans/items/properties/services"
          },
          "instrument": {
            "type": "string",
            "enum": [
              "counter",
              "up-down counter",
              "gauge",
              "histogram"
            ],
            "description": "The metric's instrument."
          },
          "when": {
            "$ref": "#/properties/spans/items/properties/when"
          },
          "planes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "description": "The only signal planes a gateway row arrives on.",
            "items": {
              "$ref": "https://xynolog.org/protocol/GatewayConfig.json#/properties/signal/properties/type"
            }
          },
          "meaning": {
            "$ref": "#/properties/spans/items/properties/meaning"
          },
          "attributes": {
            "$ref": "#/properties/spans/items/properties/attributes"
          }
        },
        "required": [
          "name",
          "services",
          "instrument",
          "when",
          "meaning",
          "attributes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$comment",
    "sdk",
    "resource",
    "spans",
    "metrics"
  ],
  "additionalProperties": false
}
