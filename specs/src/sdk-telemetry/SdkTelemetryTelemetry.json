{
  "description": "sdk-telemetry/telemetry.json: the telemetry a Xynolog SDK's transports export over OTLP: its spans and metrics, the transport each comes from, and the attributes each carries.",
  "type": "object",
  "properties": {
    "$comment": {
      "$ref": "../CaseTable.json#/properties/$comment"
    },
    "spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/name"
          },
          "transport": {
            "type": "string",
            "enum": [
              "bus",
              "content"
            ],
            "description": "The transport the row comes from: `bus`, the stream and emits; `content`, uploads and reads."
          },
          "kind": {
            "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/kind"
          },
          "meaning": {
            "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/meaning"
          },
          "attributes": {
            "type": "array",
            "description": "The attributes the row carries.",
            "items": {
              "description": "An attribute a row carries.",
              "type": "object",
              "properties": {
                "key": {
                  "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/attributes/items/properties/key"
                },
                "only": {
                  "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/attributes/items/properties/only"
                },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "The only values it carries, each of the type it is carried as: a string or a boolean.",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "transport",
          "kind",
          "meaning",
          "attributes"
        ],
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/name"
          },
          "transport": {
            "$ref": "#/properties/spans/items/properties/transport"
          },
          "instrument": {
            "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/metrics/items/properties/instrument"
          },
          "meaning": {
            "$ref": "../service-telemetry/ServiceTelemetryTelemetry.json#/properties/spans/items/properties/meaning"
          },
          "attributes": {
            "$ref": "#/properties/spans/items/properties/attributes"
          }
        },
        "required": [
          "name",
          "transport",
          "instrument",
          "meaning",
          "attributes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$comment",
    "spans",
    "metrics"
  ],
  "additionalProperties": false
}
