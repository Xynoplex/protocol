{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BusLogCases.json",
  "description": "bus/log-cases.json: what a bus log shows of a payload: the value of every member named for a credential withheld.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "names": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "The names a credential goes by.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "description": "A payload and what a log shows of it; a payload that is a channel's own names the channel.",
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "channel": {
            "$ref": "https://xynolog.org/protocol/BusFrame.json#/properties/channel"
          },
          "payload": {
            "type": "object",
            "description": "A payload, which is an object.",
            "additionalProperties": {
              "$comment": "A member's value: JSON, as it is given."
            }
          },
          "shown": {
            "$ref": "#/properties/cases/items/properties/payload"
          }
        },
        "required": [
          "why",
          "payload",
          "shown"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "names",
    "cases"
  ],
  "additionalProperties": false
}
