{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BusReplyBounds.json",
  "description": "bus/reply-bounds.json: each list or map an operation's reply carries that its own schema does not bound, and what bounds it.",
  "type": "object",
  "properties": {
    "$comment": {
      "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/$comment"
    },
    "replies": {
      "type": "object",
      "description": "Each operation, by its request's channel.",
      "additionalProperties": {
        "type": "object",
        "description": "Each list or map of the reply, by its path.",
        "additionalProperties": {
          "oneOf": [
            {
              "title": "By",
              "description": "A list or map bounded by a member of the request.",
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z]*$",
                  "description": "The member of the request that bounds it: an array, or an integer with a maximum."
                }
              },
              "required": [
                "by"
              ],
              "additionalProperties": false
            },
            {
              "title": "Grows",
              "description": "A list or map not yet bounded, which grows.",
              "type": "object",
              "properties": {
                "grows": {
                  "type": "string",
                  "pattern": "^with \\S",
                  "description": "What it grows with."
                }
              },
              "required": [
                "grows"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    }
  },
  "required": [
    "$comment",
    "replies"
  ],
  "additionalProperties": false
}
