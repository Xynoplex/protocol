{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ArchivistHealth.json",
  "type": "object",
  "description": "The Archivist's liveness answer: it serves, and the actors it hosts.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "stower",
          "browser",
          "cloneTokenManager"
        ]
      },
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "description": "The record actors this process hosts: each of the enum's, once, in the order the enum lists them."
    }
  },
  "required": [
    "status",
    "actors"
  ]
}
