{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseProfilesResult.json",
  "type": "object",
  "description": "The profiles of the principals asked after: each that has one, keyed by DID. A DID with no profile is absent, and is named by no one.",
  "properties": {
    "response": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "description": "Each profile, keyed by DID.",
          "additionalProperties": {
            "$ref": "https://xynolog.org/protocol/Profile.json"
          }
        }
      },
      "required": [
        "profiles"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "response"
  ]
}
