{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseFilesResponse.json",
  "type": "object",
  "required": [
    "path",
    "entries"
  ],
  "properties": {
    "path": {
      "type": "string",
      "description": "The directory path that was listed, relative to project root"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "https://xynolog.org/protocol/DirectoryEntry.json"
      }
    }
  },
  "additionalProperties": false
}
