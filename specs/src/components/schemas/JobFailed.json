{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobFailed.json",
  "type": "object",
  "description": "A job that failed and will not be retried.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "failed"
      ]
    },
    "metadata": {
      "$ref": "https://xynolog.org/protocol/JobMetadata.json"
    },
    "params": {
      "$ref": "https://xynolog.org/protocol/JobParams.json"
    },
    "startedAt": {
      "type": "string",
      "description": "When the last claim was made; absent when it failed without one."
    },
    "completedAt": {
      "type": "string",
      "description": "When it failed."
    },
    "error": {
      "type": "string",
      "description": "The failure's message."
    },
    "failureClass": {
      "$ref": "https://xynolog.org/protocol/FailureClass.json"
    }
  },
  "required": [
    "status",
    "metadata",
    "params",
    "completedAt",
    "error"
  ],
  "additionalProperties": false
}
