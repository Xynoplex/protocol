{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobStatusResponse.json",
  "type": "object",
  "properties": {
    "jobId": {
      "$ref": "https://xynolog.org/protocol/JobId.json"
    },
    "type": {
      "$ref": "https://xynolog.org/protocol/JobType.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "complete",
        "failed",
        "cancelled"
      ]
    },
    "userId": {
      "$ref": "https://xynolog.org/protocol/UserId.json"
    },
    "created": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "failureClass": {
      "$ref": "https://xynolog.org/protocol/FailureClass.json"
    },
    "progress": {
      "$ref": "https://xynolog.org/protocol/JobStoredProgress.json"
    },
    "result": {
      "$ref": "https://xynolog.org/protocol/JobStoredResult.json"
    }
  },
  "required": [
    "jobId",
    "type",
    "status",
    "userId",
    "created"
  ]
}
