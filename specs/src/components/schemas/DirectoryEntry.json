{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/DirectoryEntry.json",
  "oneOf": [
    {
      "$ref": "https://xynolog.org/protocol/FileEntry.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/DirEntry.json"
    }
  ],
  "discriminator": {
    "propertyName": "type",
    "mapping": {
      "file": "https://xynolog.org/protocol/FileEntry.json",
      "dir": "https://xynolog.org/protocol/DirEntry.json"
    }
  },
  "description": "One entry in a directory listing: a file, which may carry the resource it was ingested as, or a subdirectory. Tell them apart by `type`, which is required on both and single-valued."
}
