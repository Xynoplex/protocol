{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/AgentOrganization.json",
  "description": "An organization — the Organization branch of Agent.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "@type": {
      "type": "string",
      "enum": [
        "Organization"
      ]
    },
    "@id": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string"
    },
    "homepage": {
      "type": "string"
    }
  },
  "required": [
    "@type",
    "name"
  ]
}
