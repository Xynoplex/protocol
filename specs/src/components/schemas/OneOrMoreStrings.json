{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/OneOrMoreStrings.json",
  "oneOf": [
    {
      "type": "string"
    },
    {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  ],
  "description": "One string, or a non-empty list of them: a JSON-LD term that may take one value or several."
}
