{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/MarkJobCreateCommand.json",
  "type": "object",
  "description": "Create a `mark` job: annotate one resource for one motivation.",
  "properties": {
    "_userId": {
      "$ref": "https://xynolog.org/protocol/UserId.json",
      "description": "The emitter's verified DID, injected by the gateway. Clients do not set this."
    },
    "_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The emitter's roles, injected by the gateway when it has any. Clients do not set this."
    },
    "jobType": {
      "type": "string",
      "enum": [
        "mark"
      ]
    },
    "resourceId": {
      "$ref": "https://xynolog.org/protocol/ResourceId.json",
      "description": "The resource to annotate."
    },
    "params": {
      "$ref": "https://xynolog.org/protocol/MarkJobParams.json"
    }
  },
  "required": [
    "jobType",
    "resourceId",
    "params"
  ],
  "additionalProperties": false
}
