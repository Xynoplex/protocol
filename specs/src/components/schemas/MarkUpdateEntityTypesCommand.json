{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/MarkUpdateEntityTypesCommand.json",
  "type": "object",
  "description": "Bus command to replace the entity types on a resource.",
  "properties": {
    "resourceId": {
      "$ref": "https://xynolog.org/protocol/ResourceId.json"
    },
    "_userId": {
      "$ref": "https://xynolog.org/protocol/UserId.json",
      "description": "Authenticated user's DID, injected by the /bus/emit gateway. Clients do not set this."
    },
    "currentEntityTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updatedEntityTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "resourceId",
    "currentEntityTypes",
    "updatedEntityTypes"
  ]
}
