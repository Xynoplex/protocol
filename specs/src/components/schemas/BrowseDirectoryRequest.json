{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseDirectoryRequest.json",
  "type": "object",
  "description": "Request to browse a directory listing",
  "properties": {
    "path": {
      "type": "string"
    },
    "sort": {
      "type": "string",
      "enum": [
        "name",
        "mtime",
        "annotationCount"
      ]
    }
  },
  "required": [
    "path"
  ]
}
