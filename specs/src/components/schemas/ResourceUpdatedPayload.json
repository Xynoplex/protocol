{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ResourceUpdatedPayload.json",
  "type": "object",
  "description": "Payload for yield:updated domain event",
  "properties": {
    "contentChecksum": {
      "type": "string",
      "description": "SHA-256 of new content"
    },
    "contentByteSize": {
      "type": "integer"
    }
  },
  "required": [
    "contentChecksum"
  ]
}
