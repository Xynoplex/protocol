{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseEventsRequest.json",
  "type": "object",
  "description": "Request to browse events for a resource",
  "properties": {
    "resourceId": {
      "$ref": "https://xynolog.org/protocol/ResourceId.json"
    },
    "type": {
      "type": "string"
    },
    "userId": {
      "$ref": "https://xynolog.org/protocol/UserId.json"
    },
    "limit": {
      "type": "integer"
    }
  },
  "required": [
    "resourceId"
  ]
}
