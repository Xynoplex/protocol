{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseResourceReorderEvent.json",
  "type": "object",
  "description": "Emitted when resources are reordered in the browse panel",
  "properties": {
    "oldIndex": {
      "type": "integer"
    },
    "newIndex": {
      "type": "integer"
    }
  },
  "required": [
    "oldIndex",
    "newIndex"
  ]
}
