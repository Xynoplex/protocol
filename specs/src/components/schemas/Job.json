{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/Job.json",
  "description": "A job as the dispatcher holds it. Its `status` decides which timestamps and outcome fields it carries. It is what a claim returns (`job:claimed`, always `running`) and what the queue stores, inside a JobRecord.",
  "oneOf": [
    {
      "$ref": "https://xynolog.org/protocol/JobPending.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/JobRunning.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/JobComplete.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/JobFailed.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/JobCancelled.json"
    }
  ],
  "discriminator": {
    "propertyName": "status",
    "mapping": {
      "pending": "https://xynolog.org/protocol/JobPending.json",
      "running": "https://xynolog.org/protocol/JobRunning.json",
      "complete": "https://xynolog.org/protocol/JobComplete.json",
      "failed": "https://xynolog.org/protocol/JobFailed.json",
      "cancelled": "https://xynolog.org/protocol/JobCancelled.json"
    }
  }
}
