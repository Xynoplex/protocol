{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseEnginesResult.json",
  "type": "object",
  "description": "The knowledge base's engines: those its Inference document names, and the jobs it has each used for",
  "properties": {
    "response": {
      "type": "object",
      "properties": {
        "engines": {
          "type": "array",
          "items": {
            "$ref": "https://xynolog.org/protocol/EngineEntry.json"
          }
        }
      },
      "required": [
        "engines"
      ]
    }
  },
  "required": [
    "response"
  ]
}
