{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobRunning.json",
  "type": "object",
  "description": "A job a worker has claimed and not yet concluded.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "running"
      ]
    },
    "metadata": {
      "$ref": "https://xynolog.org/protocol/JobMetadata.json"
    },
    "params": {
      "$ref": "https://xynolog.org/protocol/JobParams.json"
    },
    "startedAt": {
      "type": "string",
      "description": "When the claim that holds it was made, as an ISO 8601 timestamp."
    },
    "progress": {
      "$ref": "https://xynolog.org/protocol/JobStoredProgress.json"
    }
  },
  "required": [
    "status",
    "metadata",
    "params",
    "startedAt",
    "progress"
  ],
  "additionalProperties": false
}
