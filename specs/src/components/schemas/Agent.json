{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/Agent.json",
  "description": "Web Annotation / W3C PROV Agent. Discriminated by @type — Person, Organization, or Software (named member schemas: AgentPerson, AgentOrganization, AgentSoftware). Software peers are first-class participants, not a sub-class of Person.",
  "oneOf": [
    {
      "$ref": "https://xynolog.org/protocol/AgentPerson.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/AgentOrganization.json"
    },
    {
      "$ref": "https://xynolog.org/protocol/AgentSoftware.json"
    }
  ],
  "discriminator": {
    "propertyName": "@type",
    "mapping": {
      "Person": "https://xynolog.org/protocol/AgentPerson.json",
      "Organization": "https://xynolog.org/protocol/AgentOrganization.json",
      "Software": "https://xynolog.org/protocol/AgentSoftware.json"
    }
  }
}
