{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/CloneResourceWithTokenResponse.json",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "description": "Generated clone token"
    },
    "expiresAt": {
      "type": "string",
      "description": "ISO 8601 timestamp when token expires"
    },
    "resource": {
      "$ref": "https://xynolog.org/protocol/ResourceDescriptor.json"
    }
  },
  "required": [
    "token",
    "expiresAt",
    "resource"
  ]
}
