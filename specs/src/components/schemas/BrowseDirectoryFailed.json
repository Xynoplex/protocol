{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowseDirectoryFailed.json",
  "description": "The payload of `browse:directory-failed`: a CommandError that names the directory that could not be read.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CommandError.json"
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "The path the read was asked for."
        }
      },
      "required": [
        "path"
      ]
    }
  ]
}
