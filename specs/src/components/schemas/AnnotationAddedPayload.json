{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/AnnotationAddedPayload.json",
  "type": "object",
  "description": "Payload for mark:added domain event",
  "properties": {
    "annotation": {
      "$ref": "https://xynolog.org/protocol/Annotation.json"
    },
    "contentChecksum": {
      "type": "string",
      "description": "SHA-256 of resource content at annotation time"
    }
  },
  "required": [
    "annotation"
  ]
}
