{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobPending.json",
  "type": "object",
  "description": "A job waiting for a worker to claim it.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending"
      ]
    },
    "metadata": {
      "$ref": "https://xynolog.org/protocol/JobMetadata.json"
    },
    "params": {
      "$ref": "https://xynolog.org/protocol/JobParams.json"
    }
  },
  "required": [
    "status",
    "metadata",
    "params"
  ],
  "additionalProperties": false
}
