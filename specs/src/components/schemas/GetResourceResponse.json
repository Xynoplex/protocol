{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/GetResourceResponse.json",
  "type": "object",
  "properties": {
    "resource": {
      "$ref": "https://xynolog.org/protocol/ResourceDescriptor.json"
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "https://xynolog.org/protocol/Annotation.json"
      },
      "description": "All annotations for the resource (highlights, references, assessments, etc.)"
    }
  },
  "required": [
    "resource",
    "annotations"
  ]
}
