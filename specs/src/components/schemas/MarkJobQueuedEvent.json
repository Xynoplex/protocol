{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/MarkJobQueuedEvent.json",
  "type": "object",
  "description": "A pending `mark` job, announced with its parameters as it was created.",
  "properties": {
    "jobId": {
      "$ref": "https://xynolog.org/protocol/JobId.json"
    },
    "jobType": {
      "type": "string",
      "enum": [
        "mark"
      ]
    },
    "resourceId": {
      "$ref": "https://xynolog.org/protocol/ResourceId.json",
      "description": "The resource the job is about."
    },
    "userId": {
      "$ref": "https://xynolog.org/protocol/UserId.json",
      "description": "The DID of the principal whose `job:create` created the job."
    },
    "params": {
      "$ref": "https://xynolog.org/protocol/MarkJobParams.json"
    }
  },
  "required": [
    "jobId",
    "jobType",
    "resourceId",
    "userId",
    "params"
  ]
}
