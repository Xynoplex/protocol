{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobStartedPayload.json",
  "type": "object",
  "description": "Payload for job:started domain event",
  "properties": {
    "jobId": {
      "$ref": "https://xynolog.org/protocol/JobId.json"
    },
    "jobType": {
      "$ref": "https://xynolog.org/protocol/JobType.json"
    },
    "annotationId": {
      "$ref": "https://xynolog.org/protocol/AnnotationId.json",
      "description": "Annotation this job is attached to, when applicable"
    },
    "totalSteps": {
      "type": "integer"
    }
  },
  "required": [
    "jobId",
    "jobType"
  ]
}
