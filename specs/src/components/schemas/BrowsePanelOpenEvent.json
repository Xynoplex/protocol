{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/BrowsePanelOpenEvent.json",
  "type": "object",
  "description": "Emitted when a browse panel is opened",
  "properties": {
    "panel": {
      "type": "string"
    },
    "scrollToAnnotationId": {
      "$ref": "https://xynolog.org/protocol/AnnotationId.json"
    },
    "motivation": {
      "$ref": "https://xynolog.org/protocol/Motivation.json"
    }
  },
  "required": [
    "panel"
  ]
}
