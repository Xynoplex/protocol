{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/JobComplete.json",
  "type": "object",
  "description": "A job its worker completed.",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete"
      ]
    },
    "metadata": {
      "$ref": "https://xynolog.org/protocol/JobMetadata.json"
    },
    "params": {
      "$ref": "https://xynolog.org/protocol/JobParams.json"
    },
    "startedAt": {
      "type": "string",
      "description": "When the claim that completed it was made."
    },
    "completedAt": {
      "type": "string",
      "description": "When it completed."
    },
    "result": {
      "$ref": "https://xynolog.org/protocol/JobStoredResult.json"
    }
  },
  "required": [
    "status",
    "metadata",
    "params",
    "startedAt",
    "completedAt",
    "result"
  ],
  "additionalProperties": false
}
