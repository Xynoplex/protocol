{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/MarkDeleteOk.json",
  "type": "object",
  "description": "Success reply after deleting an annotation, matched to the originating command by correlationId.",
  "properties": {
    "response": {
      "type": "object",
      "description": "The deleted annotation's identity.",
      "properties": {
        "annotationId": {
          "$ref": "https://xynolog.org/protocol/AnnotationId.json"
        }
      },
      "required": [
        "annotationId"
      ]
    }
  },
  "required": [
    "response"
  ]
}
