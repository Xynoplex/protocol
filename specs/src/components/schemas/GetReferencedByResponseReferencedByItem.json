{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/GetReferencedByResponseReferencedByItem.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://xynolog.org/protocol/AnnotationId.json",
      "description": "Reference annotation ID"
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "description": "Name of the resource containing the reference. Absent where no description of that resource is held, and where its name is empty."
    },
    "target": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "https://xynolog.org/protocol/ResourceId.json",
          "description": "ID of resource containing the reference"
        },
        "selector": {
          "type": "object",
          "properties": {
            "exact": {
              "type": "string",
              "description": "The selected text that references this resource"
            }
          },
          "required": [
            "exact"
          ]
        }
      },
      "required": [
        "source",
        "selector"
      ]
    }
  },
  "required": [
    "id",
    "target"
  ]
}
