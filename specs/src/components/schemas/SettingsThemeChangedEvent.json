{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/SettingsThemeChangedEvent.json",
  "type": "object",
  "description": "Emitted when the UI theme setting changes",
  "properties": {
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ]
    }
  },
  "required": [
    "theme"
  ]
}
