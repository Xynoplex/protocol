{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/TextualBody.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "TextualBody"
      ]
    },
    "value": {
      "type": "string",
      "description": "The text content (e.g., entity type name)"
    },
    "purpose": {
      "$ref": "https://xynolog.org/protocol/BodyPurpose.json",
      "description": "Why this body is included"
    },
    "format": {
      "type": "string",
      "description": "MIME type (defaults to text/plain)"
    },
    "language": {
      "type": "string",
      "description": "BCP 47 language tag"
    }
  },
  "required": [
    "type",
    "value"
  ]
}
