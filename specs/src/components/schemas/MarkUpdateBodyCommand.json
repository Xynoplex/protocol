{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/MarkUpdateBodyCommand.json",
  "type": "object",
  "description": "Bus command to update an annotation's body with patch operations.",
  "properties": {
    "_userId": {
      "$ref": "https://xynolog.org/protocol/UserId.json",
      "description": "Authenticated user's DID, injected by the /bus/emit gateway. Clients do not set this."
    },
    "annotationId": {
      "$ref": "https://xynolog.org/protocol/AnnotationId.json"
    },
    "resourceId": {
      "$ref": "https://xynolog.org/protocol/ResourceId.json"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "https://xynolog.org/protocol/BodyOperation.json"
      }
    }
  },
  "required": [
    "annotationId",
    "resourceId",
    "operations"
  ]
}
