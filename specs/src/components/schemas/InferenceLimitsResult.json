{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/InferenceLimitsResult.json",
  "type": "object",
  "description": "The inference limits one service discovered for the engines it holds a client for. An engine whose discovery is currently unavailable is absent.",
  "properties": {
    "response": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "array",
          "items": {
            "$ref": "https://xynolog.org/protocol/EngineLimits.json"
          }
        }
      },
      "required": [
        "limits"
      ]
    }
  },
  "required": [
    "response"
  ]
}
