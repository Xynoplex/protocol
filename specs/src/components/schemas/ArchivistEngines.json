{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ArchivistEngines.json",
  "type": "object",
  "description": "The engine for each job and each Librarian actor, behind `browse:engines`: a provider and a model, and no credential. It is the knowledge base's Inference document's `engines` as they stand, with no fallback, so a job or an actor absent here has no engine.",
  "properties": {
    "jobs": {
      "type": "object",
      "description": "The engine each job is done with when software does it, keyed as a job description is: by `jobType`, and for `mark` by motivation.",
      "properties": {
        "mark": {
          "type": "object",
          "description": "The engine for `mark` jobs of each motivation.",
          "properties": {
            "highlighting": {
              "$ref": "https://xynolog.org/protocol/Engine.json"
            },
            "commenting": {
              "$ref": "https://xynolog.org/protocol/Engine.json"
            },
            "assessing": {
              "$ref": "https://xynolog.org/protocol/Engine.json"
            },
            "linking": {
              "$ref": "https://xynolog.org/protocol/Engine.json"
            },
            "tagging": {
              "$ref": "https://xynolog.org/protocol/Engine.json"
            }
          },
          "additionalProperties": false
        },
        "yield": {
          "$ref": "https://xynolog.org/protocol/Engine.json"
        }
      },
      "additionalProperties": false
    },
    "actors": {
      "type": "object",
      "description": "The engine each Librarian actor that calls a model asks.",
      "properties": {
        "gatherer": {
          "$ref": "https://xynolog.org/protocol/Engine.json"
        },
        "matcher": {
          "$ref": "https://xynolog.org/protocol/Engine.json"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "jobs",
    "actors"
  ],
  "additionalProperties": false
}
