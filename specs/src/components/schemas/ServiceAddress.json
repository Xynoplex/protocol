{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ServiceAddress.json",
  "type": "object",
  "description": "The host and port a service listens at.",
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "required": [
    "host",
    "port"
  ],
  "additionalProperties": false
}
