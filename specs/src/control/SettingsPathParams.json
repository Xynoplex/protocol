{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/SettingsPathParams.json",
  "title": "SettingsPathParams",
  "type": "object",
  "description": "settings.path's params.",
  "properties": {
    "apiVersion": {
      "$ref": "https://xynolog.org/protocol/ApiVersion.json",
      "description": "The version of the control API the request is written to."
    },
    "document": {
      "type": "string",
      "description": "Whose document: the Browser's, the worker's, the issuer's or the vector store's.",
      "enum": [
        "browser",
        "worker",
        "issuer",
        "vectors"
      ]
    }
  },
  "required": [
    "apiVersion",
    "document"
  ],
  "additionalProperties": false
}
