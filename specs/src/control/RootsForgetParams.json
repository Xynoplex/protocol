{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/RootsForgetParams.json",
  "title": "RootsForgetParams",
  "type": "object",
  "description": "roots.forget's params.",
  "properties": {
    "apiVersion": {
      "$ref": "https://xynolog.org/protocol/ApiVersion.json",
      "description": "The version of the control API the request is written to."
    },
    "root": {
      "type": "string",
      "description": "The registered root to forget: its path, or its basename when only one registered root has it.",
      "minLength": 1
    }
  },
  "required": [
    "apiVersion",
    "root"
  ],
  "additionalProperties": false
}
