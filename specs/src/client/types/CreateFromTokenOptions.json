{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/CreateFromTokenOptions.json",
  "title": "CreateFromTokenOptions",
  "type": "object",
  "additionalProperties": false,
  "description": "What creating a resource from a clone token is told: the token, the clone's name and text, and whether the source is archived once the clone exists.",
  "properties": {
    "token": {
      "$ref": "https://xynolog.org/protocol/YieldCloneCreateCommand.json#/properties/token"
    },
    "name": {
      "$ref": "https://xynolog.org/protocol/YieldCloneCreateCommand.json#/properties/name"
    },
    "content": {
      "type": "string",
      "description": "The clone's text, uploaded as its content."
    },
    "archiveOriginal": {
      "$ref": "https://xynolog.org/protocol/YieldCloneCreateCommand.json#/properties/archiveOriginal"
    }
  },
  "required": [
    "token",
    "name",
    "content"
  ]
}
