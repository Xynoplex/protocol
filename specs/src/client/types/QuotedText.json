{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/QuotedText.json",
  "title": "QuotedText",
  "type": "object",
  "description": "Words of a text, as a selection quotes them: the words themselves, and maybe the text just before and just after them, which tell apart the places they occur.",
  "properties": {
    "exact": {
      "type": "string",
      "description": "The words quoted."
    },
    "prefix": {
      "type": "string",
      "description": "The text just before them."
    },
    "suffix": {
      "type": "string",
      "description": "The text just after them."
    }
  },
  "required": [
    "exact"
  ]
}
