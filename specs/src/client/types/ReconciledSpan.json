{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ReconciledSpan.json",
  "title": "ReconciledSpan",
  "description": "Where a quoted selection was found in a text, and how it was found.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/TextSpan.json"
    },
    {
      "type": "object",
      "properties": {
        "anchorMethod": {
          "$ref": "https://xynolog.org/protocol/AnchorMethod.json"
        },
        "matchQuality": {
          "$ref": "https://xynolog.org/protocol/MatchQuality.json"
        }
      },
      "required": [
        "anchorMethod"
      ]
    }
  ]
}
