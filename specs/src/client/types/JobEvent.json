{
  "title": "JobEvent",
  "description": "What a delegation reports as its job goes, told apart by `kind`: the queue's naming of the job first, its progress, and last, its failure, a frame refused, or its completion. Each operation that delegates completes with its own verb's completion, a branch of JobCompleteCommand.",
  "oneOf": [
    {
      "type": "object",
      "description": "The queue took the job.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "created"
          ]
        },
        "data": {
          "$ref": "../../components/schemas/JobCreatedResultResponse.json"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "description": "The job's progress.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "progress"
          ]
        },
        "data": {
          "$ref": "../../components/schemas/JobProgress.json"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "description": "The job failed.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        "data": {
          "$ref": "../../components/schemas/JobFailCommand.json"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "description": "A frame of the job's was refused: its channel, the member at fault, and why.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "refused"
          ]
        },
        "data": {
          "type": "object",
          "properties": {
            "channel": {
              "type": "string",
              "description": "The channel the frame came on."
            },
            "member": {
              "type": "string",
              "description": "The member at fault, named by its way from the frame."
            },
            "reason": {
              "$ref": "./FrameRefusalReason.json"
            }
          },
          "required": [
            "channel",
            "member",
            "reason"
          ]
        }
      },
      "required": [
        "kind",
        "data"
      ]
    },
    {
      "type": "object",
      "description": "The job completed.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "complete"
          ]
        },
        "data": {
          "$ref": "../../components/schemas/JobCompleteCommand.json"
        }
      },
      "required": [
        "kind",
        "data"
      ]
    }
  ],
  "discriminator": {
    "propertyName": "kind"
  }
}
