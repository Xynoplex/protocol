{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/AnnotationsReconcileCases.json",
  "description": "annotations/reconcile-cases.json: where a quoted span is in a text, reconciled, or null where it is refused.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "why": {
            "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
          },
          "text": {
            "type": "string",
            "description": "The real text."
          },
          "quoted": {
            "$ref": "https://xynolog.org/protocol/QuotedText.json"
          },
          "reconciled": {
            "anyOf": [
              {
                "$ref": "https://xynolog.org/protocol/ReconciledSpan.json"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "why",
          "text",
          "quoted",
          "reconciled"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
