{
  "description": "text/encoding-cases.json: every label of the Encoding Standard, the encoding it names, and what a reader does with bytes said to be in it.",
  "allOf": [
    {
      "$ref": "../CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "description": "A single-byte encoding, read byte by byte.",
            "type": "object",
            "properties": {
              "encoding": {
                "type": "string",
                "pattern": "^[^\\sA-Z]+$",
                "description": "The encoding, by its name in lower case."
              },
              "labels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "description": "Its labels, in lower case, its name among them.",
                "items": {
                  "type": "string",
                  "pattern": "^[^\\sA-Z]+$"
                }
              },
              "everyByte": {
                "type": "string",
                "minLength": 256,
                "maxLength": 256,
                "description": "The text the 256 bytes 00 to ff are, in that order: one character to a byte."
              }
            },
            "required": [
              "encoding",
              "labels",
              "everyByte"
            ],
            "additionalProperties": false
          },
          {
            "description": "An encoding read in it, by some bytes and the text they are.",
            "type": "object",
            "properties": {
              "encoding": {
                "$ref": "#/properties/cases/items/oneOf/0/properties/encoding"
              },
              "labels": {
                "$ref": "#/properties/cases/items/oneOf/0/properties/labels"
              },
              "bytes": {
                "$ref": "./TextDecodeCases.json#/properties/cases/items/oneOf/0/properties/bytes"
              },
              "text": {
                "type": "string",
                "description": "The text the bytes are."
              }
            },
            "required": [
              "encoding",
              "labels",
              "bytes",
              "text"
            ],
            "additionalProperties": false
          },
          {
            "description": "An encoding whose every label a reader refuses, whatever the bytes are.",
            "type": "object",
            "properties": {
              "encoding": {
                "$ref": "#/properties/cases/items/oneOf/0/properties/encoding"
              },
              "labels": {
                "$ref": "#/properties/cases/items/oneOf/0/properties/labels"
              },
              "refused": {
                "type": "boolean",
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "encoding",
              "labels",
              "refused"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
