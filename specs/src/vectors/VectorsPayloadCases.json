          {
            "title": "CollectionsNamed",
            "type": "object",
            "properties": {
              "why": {
                "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
              },
              "collectionsNamed": {
                "description": "A knowledge base's DID, and the names of its collections.",
                "type": "object",
                "properties": {
                  "kb": {
                    "$ref": "https://xynolog.org/protocol/KbDid.json"
                  },
                  "names": {
                    "description": "Its collections' names, under their words: the SHA-256 of the DID's UTF-8 bytes, in lower-case hexadecimal, a hyphen and the word.",
                    "type": "object",
                    "properties": {
                      "resources": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}-resources$"
                      },
                      "annotations": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}-annotations$"
