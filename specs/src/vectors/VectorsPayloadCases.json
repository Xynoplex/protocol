                  "text": {
                    "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/text"
                  },
                  "embedding": {
                    "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/chunks/items/properties/embedding"
                  },
                  "machineRead": {
                    "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/machineRead"
                  },
                  "point": {
                    "description": "The one point the annotation becomes.",
                    "type": "object",
                    "properties": {
                      "qdrantId": {
                        "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/qdrantId"
                      },
                      "payload": {
                        "description": "A point of the annotations' payload, whole.",
                        "type": "object",
                        "properties": {
                          "annotationId": {
                            "$ref": "https://xynolog.org/protocol/AnnotationId.json"
                          },
                          "resourceId": {
                            "$ref": "https://xynolog.org/protocol/ResourceId.json"
                          },
                          "motivation": {
                            "$ref": "https://xynolog.org/protocol/Motivation.json"
                          },
                          "entityTypes": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/entityTypes"
                          },
                          "text": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/text"
                          },
                          "machineRead": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/machineRead"
                          }
                        },
                        "required": [
                          "annotationId",
                          "resourceId",
                          "motivation",
                          "entityTypes",
                          "text"
                        ],
                        "additionalProperties": false
                      },
                      "result": {
                        "type": "object",
                        "properties": {
                          "score": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/result/properties/score"
                          },
                          "resourceId": {
                            "$ref": "https://xynolog.org/protocol/ResourceId.json"
                          },
                          "annotationId": {
                            "$ref": "https://xynolog.org/protocol/AnnotationId.json"
                          },
                          "text": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/text"
                          },
                          "entityTypes": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/entityTypes"
                          },
                          "machineRead": {
                            "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/machineRead"
                          }
                        },
                        "required": [
                          "score",
                          "resourceId",
                          "annotationId",
                          "text",
                          "entityTypes"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "qdrantId",
                      "payload",
                      "result"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "annotationId",
                  "resourceId",
                  "motivation",
                  "entityTypes",
                  "text",
                  "embedding",
                  "point"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "why",
              "annotationStored"
            ],
            "additionalProperties": false
          },
          {
            "title": "DeclineStored",
            "type": "object",
            "properties": {
              "why": {
                "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
              },
              "declineStored": {
                "description": "A declined resource remembered, and the point it becomes.",
