{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/VectorsPayloadCases.json",
  "description": "vectors/payload-cases.json: what a point of the vector index is, as every implementation of the index writes it and reads it.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "collections": {
      "description": "Each of a knowledge base's three collections, under the word that names it, as Qdrant is asked to make it.",
      "type": "object",
      "properties": {
        "resources": {
          "description": "A collection that is searched, as Qdrant is asked to make it: as wide as the embedding model's vectors, which no number here states.",
          "type": "object",
          "properties": {
            "distance": {
              "type": "string",
              "enum": [
                "Cosine"
              ],
              "description": "The distance its vectors are compared by, in Qdrant's word: the cosine of the angle between them."
            },
            "indexes": {
              "type": "object",
              "description": "The payload members Qdrant is asked to index, and as what, in Qdrant's word.",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "distance",
            "indexes"
          ],
          "additionalProperties": false
        },
        "annotations": {
          "$ref": "#/properties/collections/properties/resources"
        },
        "declined": {
          "description": "The declined, never searched, as Qdrant is asked to make it.",
          "type": "object",
          "properties": {
            "distance": {
              "type": "string",
              "enum": [
                "Dot"
              ],
              "description": "The dot product, since a vector of 0 has no length to keep."
            },
            "size": {
              "type": "integer",
              "enum": [
                1
              ],
              "description": "How wide its vectors are: one number, 0, which says nothing."
            },
            "indexes": {
              "$ref": "#/properties/collections/properties/resources/properties/indexes"
            }
          },
          "required": [
            "distance",
            "size",
            "indexes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "resources",
        "annotations",
        "declined"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "ResourceStored",
            "type": "object",
            "properties": {
              "why": {
                "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
              },
              "resourceStored": {
                "description": "A resource's chunks stored, and the points they become.",
                "type": "object",
                "properties": {
                  "resourceId": {
                    "$ref": "https://xynolog.org/protocol/ResourceId.json"
                  },
                  "chunks": {
                    "description": "The chunks the resource's text was cut into.",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": {
                          "type": "integer",
                          "minimum": 0,
                          "description": "The chunk's place among the resource's chunks, from 0."
                        },
                        "text": {
                          "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/text"
                        },
                        "embedding": {
                          "type": "array",
                          "minItems": 1,
                          "description": "The vector a model made of the text.",
                          "items": {
                            "type": "number"
                          }
                        }
                      },
                      "required": [
                        "index",
                        "text",
                        "embedding"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "contentChecksum": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The checksum of the bytes the text came from, as it is given."
                  },
                  "mediaType": {
                    "type": "string",
                    "minLength": 1,
                    "description": "The media type the bytes were read as, with whatever parameters it states, as it is given."
                  },
                  "entityTypes": {
                    "description": "The entity types, in the order given.",
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "machineRead": {
                    "type": "boolean",
                    "description": "Whether the caller says the text was read from pixels."
                  },
                  "points": {
                    "description": "The points the chunks become, in the chunks' order.",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "qdrantId": {
                          "type": "string",
                          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
                          "description": "The id Qdrant keys the point by: the MD5 of its key, in a UUID's groups."
                        },
                        "payload": {
                          "description": "A point of the resources' payload, whole.",
                          "type": "object",
                          "properties": {
                            "resourceId": {
                              "$ref": "https://xynolog.org/protocol/ResourceId.json"
                            },
                            "chunkIndex": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/chunks/items/properties/index"
                            },
                            "text": {
                              "type": "string",
                              "description": "The text, carried and never counted."
                            },
                            "contentChecksum": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/contentChecksum"
                            },
                            "mediaType": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/mediaType"
                            },
                            "entityTypes": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/entityTypes"
                            },
                            "machineRead": {
                              "type": "boolean",
                              "enum": [
                                true
                              ],
                              "description": "Present, and true, where the point's text was read from pixels: never false."
                            }
                          },
                          "required": [
                            "resourceId",
                            "chunkIndex",
                            "text",
                            "contentChecksum",
                            "mediaType",
                            "entityTypes"
                          ],
                          "additionalProperties": false
                        },
                        "result": {
                          "description": "What a search by the point's own embedding answers of it.",
                          "type": "object",
                          "properties": {
                            "score": {
                              "type": "number",
                              "minimum": -1,
                              "maximum": 1,
                              "description": "The cosine of the angle between the two vectors, to six decimal places."
                            },
                            "resourceId": {
                              "$ref": "https://xynolog.org/protocol/ResourceId.json"
                            },
                            "text": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/text"
                            },
                            "entityTypes": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/entityTypes"
                            },
                            "machineRead": {
                              "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/machineRead"
                            }
                          },
                          "required": [
                            "score",
                            "resourceId",
                            "text",
                            "entityTypes"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "qdrantId",
                        "payload",
                        "result"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "stamp": {
                    "description": "What the resource's points then say of it as a whole.",
                    "type": "object",
                    "properties": {
                      "contentChecksum": {
                        "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/contentChecksum"
                      },
                      "mediaType": {
                        "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/mediaType"
                      },
                      "entityTypes": {
                        "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/entityTypes"
                      },
                      "machineRead": {
                        "$ref": "#/properties/cases/items/oneOf/0/properties/resourceStored/properties/points/items/properties/payload/properties/machineRead"
                      }
                    },
                    "required": [
                      "contentChecksum",
                      "mediaType",
                      "entityTypes"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "resourceId",
                  "chunks",
                  "contentChecksum",
                  "mediaType",
                  "entityTypes",
                  "points",
                  "stamp"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "why",
              "resourceStored"
            ],
            "additionalProperties": false
          },
          {
            "title": "AnnotationStored",
            "type": "object",
            "properties": {
