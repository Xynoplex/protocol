{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xynolog.org/protocol/ResourcesReaderCases.json",
  "description": "resources/reader-cases.json: what the readers of a resource's description answer of it, or the first fault a resource the schema does not allow is refused for.",
  "allOf": [
    {
      "$ref": "https://xynolog.org/protocol/CaseTable.json"
    }
  ],
  "type": "object",
  "properties": {
    "$comment": true,
    "cases": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "title": "Read",
            "description": "A resource the readers read: its primary representation and media type, absent where it has no representation, and its entity types.",
            "type": "object",
            "properties": {
              "why": {
                "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
              },
              "resource": {
                "$ref": "https://xynolog.org/protocol/ResourceDescriptor.json"
              },
              "primaryRepresentation": {
                "$ref": "https://xynolog.org/protocol/Representation.json"
              },
              "primaryMediaType": {
                "$ref": "https://xynolog.org/protocol/Representation.json#/properties/mediaType"
              },
              "entityTypes": {
                "$ref": "https://xynolog.org/protocol/ResourceDescriptor.json#/properties/entityTypes"
              }
            },
            "required": [
              "why",
              "resource",
              "entityTypes"
            ],
            "additionalProperties": false
          },
          {
            "title": "Refused",
            "description": "A resource refused for its first fault.",
            "type": "object",
            "properties": {
              "why": {
                "$ref": "https://xynolog.org/protocol/CaseTable.json#/properties/cases/items/properties/why"
              },
              "resource": {
                "$comment": "A resource the ResourceDescriptor schema does not allow: JSON, as it is given."
              },
              "refused": {
                "type": "boolean",
                "enum": [
                  true
                ]
              },
              "member": {
                "type": "string",
                "pattern": "^@?[A-Za-z]+(\\.@?[A-Za-z]+)*$",
                "description": "The way to the first fault: the names of the members it is within, and its own, joined by dots."
              },
              "reason": {
                "type": "string",
                "enum": [
                  "lacks",
                  "malformed"
                ],
                "description": "`lacks`: the resource does not carry the member, or it holds null where it may not; `malformed`: the member is not what its schema allows."
              }
            },
            "required": [
              "why",
              "resource",
              "refused",
              "member",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "cases"
  ],
  "additionalProperties": false
}
